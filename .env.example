APP_ENV=local
DEBUG=true

# Database
POSTGRES_USER=meio_user
POSTGRES_PASSWORD=meio_password
POSTGRES_DB=meio_db

# Local database url (from host)
DATABASE_URL=postgresql+psycopg://meio_user:meio_password@localhost:5432/meio_db

# Database url for docker container
# DATABASE_URL=postgresql+psycopg://meio_user:meio_password@postgres:5432/meio_db

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
OPTIMIZATION_TIMEOUT_SECONDS=60
