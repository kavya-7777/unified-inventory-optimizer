APP_ENV=local
DEBUG=true

# Database (MySQL 8). docker-compose creates it with these values.
MYSQL_DATABASE=uio
MYSQL_USER=uio
MYSQL_PASSWORD=uio_password
MYSQL_ROOT_PASSWORD=root_password
# Host port for the MySQL container (3307 avoids clashing with a MySQL already on 3306)
MYSQL_HOST_PORT=3307

# Used when running the backend directly on your machine (docker-compose sets its own).
DATABASE_URL=mysql+pymysql://uio:uio_password@localhost:3307/uio
# Hosted MySQL (Aiven): paste the Service URI as DATABASE_URL — mysql://…?ssl-mode=REQUIRED
# turns TLS on automatically. Optionally paste the CA certificate to also verify the server:
DATABASE_SSL_CA=

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
OPTIMIZATION_TIMEOUT_SECONDS=60

# ── Login ───────────────────────────────────────────────────────────────────
# Signs session tokens. Required (32+ random characters) when APP_ENV=production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# First admin account, created automatically while the users table is empty.
# Locally docker-compose defaults these to admin@example.com / admin12345.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Machine token for scheduled jobs (the nightly GitHub Action sends it as a Bearer token).
# People never use it; leave empty to disable.
API_KEY=
